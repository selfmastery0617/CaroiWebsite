# Public site URL used for metadata, canonical links, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Address that receives contact form submissions once an email provider is connected.
CONTACT_EMAIL=YOUR_EMAIL

# API key for the Resend email service (https://resend.com).
# Leave unset in development — the contact API route will respond with a
# clear "not configured" message instead of silently pretending to send mail.
RESEND_API_KEY=
